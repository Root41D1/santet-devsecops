# Non-secret selection policy for Santet multi-cloud assessments.
# Copy values into your shell or an ignored local file. Never add credentials.

SANTET_CLOUD_TARGET=production
SANTET_CLOUD_SEVERITIES="critical high"
SANTET_CLOUD_REGIONS=
SANTET_CLOUD_SERVICES=
SANTET_CLOUD_CHECKS=
SANTET_CLOUD_COMPLIANCE=

# Set one absolute provider CLI profile directory when using Docker mode.
# Examples: $HOME/.aws, $HOME/.azure, $HOME/.config/gcloud, $HOME/.aliyun
SANTET_CLOUD_CREDENTIAL_DIR=

# AWS selection
SANTET_AWS_PROFILE=
SANTET_AWS_ROLE_ARN=
SANTET_AWS_EXTERNAL_ID=

# Azure selection: sp, cli, or managed
SANTET_AZURE_AUTH=sp
SANTET_AZURE_SUBSCRIPTION_IDS=
SANTET_AZURE_REGION=

# GCP selection
SANTET_GCP_ORGANIZATION_ID=
SANTET_GCP_PROJECT_IDS=

# Alibaba Cloud selection
SANTET_ALIBABA_ROLE_ARN=
SANTET_ALIBABA_OIDC_ROLE_ARN=
SANTET_ALIBABA_ECS_RAM_ROLE=

# Set true only when intentionally using a cloud instance metadata identity.
SANTET_CLOUD_ALLOW_METADATA=false
